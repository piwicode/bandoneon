/* Single source of truth for the global property system.
 *
 * No header guard: this file is #included repeatedly, each time with a
 * different PROPERTY() definition, to generate the live-value struct, the
 * descriptor table and the compile-time tag check.
 *
 * PROPERTY(tag, type, name, <named metadata...>)
 *   tag             permanent identity of the saved value in flash (property_store.h).
 *                   NEVER reuse a tag, even after a property is removed.
 *                   0 (PROPERTY_TAG_NONE) marks a transient (never saved) property.
 *   type            C type of the value: uint16_t or bool
 *   name            struct member (direct read g_properties->name) and, stringized,
 *                   the lookup name
 *   .factory_value  the firmware's value (bool: 0/1). A saved value, set from the
 *                   web tool, overrides it at boot; property_reset() restores the
 *                   saved value if there is one, else this.
 *   .min .max       inclusive bounds; set() clamps, a saved value outside them is
 *                   ignored at boot. Omit for bool (range is implicitly 0..1).
 *   .description    short text for the editor and console help, shown next to
 *                   the name: don't repeat what the name says (program, pedal,
 *                   _ms/_us/_hz unit), so per-program and per-pedal strings are
 *                   identical and the compiler stores them once.
 */

PROPERTY(1, uint16_t, key_press,
         .factory_value = 1900, .min = 0, .max = 4095,
         .description = "Key presses at ADC <= this")
PROPERTY(2, uint16_t, key_release,
         .factory_value = 2100, .min = 0, .max = 4095,
         .description = "Key releases at ADC >= this")

/* The rest position is a property of the hardware, not of the playing style,
 * so it is shared by all bellows programs. Factory value measured on hardware
 * at ADC oversampling RightBitShift_5. */
PROPERTY(3, uint16_t, bellow_center,
         .factory_value = 28972, .min = 17000, .max = 34000,
         .description = "Combined hall reading at rest")

/* Bellows programs: FN1 cycles bellow_program through BELLOW_PROGRAM_COUNT
 * (bellow.h) sets of dead zone, travel and response curves, each
 * BELLOW_PROGRAM() owning 11 consecutive tags from tag0:
 *   BELLOW_PROGRAM(n, tag0, push_travel, (x1, y1), (x2, y2),
 *                           pull_travel, (x1, y1), (x2, y2))
 * where each (x, y) is a cubic-Bezier control point default, /256. Travels are
 * offsets from bellow_center, so recalibrating the center keeps every program. */
#define BELLOW_CP_X(x, y) x
#define BELLOW_CP_Y(x, y) y
#define BELLOW_PROGRAM(n, tag0, push_travel_default, push_p1, push_p2, \
                       pull_travel_default, pull_p1, pull_p2) \
PROPERTY(tag0 + 0, uint16_t, bellow_p##n##_dead, \
         .factory_value = 32, .min = 0, .max = 4095, \
         .description = "Dead zone width; direction registers at center +-(dead+hyst)/2") \
PROPERTY(tag0 + 1, uint16_t, bellow_p##n##_push_travel, \
         .factory_value = push_travel_default, .min = 0, .max = 17000, \
         .description = "Full push: drop below bellow_center") \
PROPERTY(tag0 + 2, uint16_t, bellow_p##n##_pull_travel, \
         .factory_value = pull_travel_default, .min = 0, .max = 17000, \
         .description = "Full pull: rise above bellow_center") \
PROPERTY(tag0 + 3, uint16_t, bellow_p##n##_push_curve_x1, \
         .factory_value = BELLOW_CP_X push_p1, .min = 0, .max = 256, \
         .description = "Push curve P1.x, 1/256 (near center)") \
PROPERTY(tag0 + 4, uint16_t, bellow_p##n##_push_curve_y1, \
         .factory_value = BELLOW_CP_Y push_p1, .min = 0, .max = 256, \
         .description = "Push curve P1.y, 1/256 (near center)") \
PROPERTY(tag0 + 5, uint16_t, bellow_p##n##_push_curve_x2, \
         .factory_value = BELLOW_CP_X push_p2, .min = 0, .max = 256, \
         .description = "Push curve P2.x, 1/256 (near full travel)") \
PROPERTY(tag0 + 6, uint16_t, bellow_p##n##_push_curve_y2, \
         .factory_value = BELLOW_CP_Y push_p2, .min = 0, .max = 256, \
         .description = "Push curve P2.y, 1/256 (near full travel)") \
PROPERTY(tag0 + 7, uint16_t, bellow_p##n##_pull_curve_x1, \
         .factory_value = BELLOW_CP_X pull_p1, .min = 0, .max = 256, \
         .description = "Pull curve P1.x, 1/256 (near center)") \
PROPERTY(tag0 + 8, uint16_t, bellow_p##n##_pull_curve_y1, \
         .factory_value = BELLOW_CP_Y pull_p1, .min = 0, .max = 256, \
         .description = "Pull curve P1.y, 1/256 (near center)") \
PROPERTY(tag0 + 9, uint16_t, bellow_p##n##_pull_curve_x2, \
         .factory_value = BELLOW_CP_X pull_p2, .min = 0, .max = 256, \
         .description = "Pull curve P2.x, 1/256 (near full travel)") \
PROPERTY(tag0 + 10, uint16_t, bellow_p##n##_pull_curve_y2, \
         .factory_value = BELLOW_CP_Y pull_p2, .min = 0, .max = 256, \
         .description = "Pull curve P2.y, 1/256 (near full travel)")

/* p0 is the nominal travel; p1 and p2 reach full expression with 1/1.5 and
 * 1/2 of it, like the former x1.5 and x2.0 sensitivity levels. */
BELLOW_PROGRAM(0, 4, 3123, (10, 0), (245, 256), 3028, (10, 0), (245, 256))
BELLOW_PROGRAM(1, 15, 2082, (10, 0), (245, 256), 2019, (10, 0), (245, 256))
BELLOW_PROGRAM(2, 26, 1562, (10, 0), (245, 256), 1514, (10, 0), (245, 256))
#undef BELLOW_PROGRAM
#undef BELLOW_CP_X
#undef BELLOW_CP_Y
PROPERTY(37, uint16_t, bellow_program,
         .factory_value = 0, .min = 0, .max = 2,
         .description = "Active bellow_p<n>_* set; FN1 cycles it")

