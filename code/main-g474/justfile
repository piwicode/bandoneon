default:
    @just --list

# Build and run host unit tests for HAL-free modules (e.g. properties)
test:
    mkdir -p build
    cc -std=c11 -Wall -Wextra -Iapp app/hysteresis_test.c -o build/hysteresis_test
    ./build/hysteresis_test
    cc -std=c11 -Wall -Wextra -I../common/console properties/properties_test.c properties/properties.c properties/properties_console.c -o build/properties_test
    ./build/properties_test
    cc -std=c11 -Wall -Wextra -Iapp app/bellow_classify.c app/bellow_classify_test.c -o build/bellow_classify_test
    ./build/bellow_classify_test
    cc -std=c11 -Wall -Wextra -Iapp -lm app/bellow_classify.c app/bellow_phys.c app/bellow_physical_sim_test.c -o build/bellow_physical_sim_test
    ./build/bellow_physical_sim_test

# Generate build system into build/Debug. Re-run after adding/removing source files or changing CMakeLists.txt.
init_build:
    cmake --preset Debug

build:
    cmake --build --preset Debug

# Generate build system into build/Release. Re-run after adding/removing source files or changing CMakeLists.txt.
init_build_release:
    cmake --preset Release

build_release:
    cmake --build --preset Release

# Record this board's chip UID in the registry. Run once per board before the first flash.
registry_add:
    ../tool/registry.py add $(basename $(pwd))

# Flash the Debug build over SWD. Links at 0x08000000, so it REPLACES the bootloader.
flash:
    name=$(basename $(pwd)) && \
    arm-none-eabi-objcopy -O binary build/Debug/$name.elf build/Debug/$name.bin && \
    ../tool/flash.py "$name" build/Debug/$name.bin

# Package the Release firmware as a .uf2 to copy onto the BANDOLIBRE drive.
dfu: init_build_release build_release
    arm-none-eabi-objcopy -O binary build/Release/main-g474.elf build/Release/main-g474.bin
    ../tool/uf2.py build/Release/main-g474.bin build/Release/main-g474.uf2

# Install bootloader + Release application over SWD. Once per board, and after `just flash`.
flash_release: init_build_release build_release
    cd ../boot-g474 && just flash
    arm-none-eabi-objcopy -O binary build/Release/main-g474.elf build/Release/main-g474.bin
    ../tool/flash.py main-g474 build/Release/main-g474.bin --address 0x08008000

# Reset the board via STLink
reset:
    st-flash reset

